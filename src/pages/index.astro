---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { FaqAccordion } from '../components/interactive/FaqAccordion';
import { buttonVariants } from '../components/ui/button';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pradnya Prameswara",
  "url": "https://production-domain-required.com",
  "sameAs": [
    "https://www.linkedin.com/in/pradnyaprameswara/"
  ],
  "description": "Pradnya designs and develops focused web experiences."
};

const imagery = {
  hero: 'https://images.unsplash.com/photo-1752223638233-4c9545333f89?auto=format&fit=crop&fm=jpg&q=84&w=2400',
  product: 'https://images.unsplash.com/photo-1764755932155-dabbee87df7e?auto=format&fit=crop&fm=jpg&q=84&w=2000',
  studio: 'https://images.unsplash.com/photo-1737474707380-5ef35770d8a7?auto=format&fit=crop&q=84&w=2200',
};
---

<Layout
  title="Pradnya — Web Design & Development"
  description="Pradnya designs and develops focused web experiences, combining technical precision with premium design execution."
  structuredData={structuredData}
>
  <SiteHeader slot="header" />

  <main class="flex flex-col overflow-hidden bg-[#f5f5f7]">
    <!-- Hero -->
    <section class="relative px-5 pb-20 pt-28 sm:px-8 md:pb-28 md:pt-40 lg:pt-48">
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-0 h-[720px] bg-[radial-gradient(circle_at_50%_10%,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.7)_28%,rgba(245,245,247,0)_72%)]"></div>

      <div class="relative z-10 mx-auto max-w-[1280px]">
        <div class="mx-auto max-w-5xl text-center">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-[#6e6e73] md:text-[13px]">
            Independent design engineering · Bali / Remote
          </p>
          <h1 data-motion="hero-headline" class="text-balance text-[clamp(3.3rem,8vw,7.6rem)] font-semibold leading-[0.93] tracking-[-0.055em] text-[#1d1d1f]">
            Digital products.<br />Engineered to feel effortless.
          </h1>
          <p data-motion="hero-copy" class="mx-auto mt-8 max-w-3xl text-balance text-[clamp(1.15rem,2.1vw,1.55rem)] leading-[1.45] tracking-[-0.018em] text-[#6e6e73] md:mt-10">
            I design and build fast, precise web experiences where interface, engineering, and business intent work as one system.
          </p>

          <div class="mt-9 flex flex-wrap items-center justify-center gap-x-7 gap-y-4 md:mt-11">
            <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'rounded-full px-7' })}>
              Start a project
            </a>
            <a href="/work" class="group inline-flex items-center gap-1.5 text-[17px] font-medium text-[#0066cc] transition-colors hover:text-[#004f9f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0071e3] focus-visible:ring-offset-4">
              View selected work
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">›</span>
            </a>
          </div>
        </div>

        <figure data-motion="hero-media" class="relative mt-16 overflow-hidden rounded-[28px] bg-[#e8e8ed] shadow-[0_28px_80px_rgba(0,0,0,0.10)] md:mt-24 md:rounded-[34px]">
          <div class="aspect-[4/5] sm:aspect-[16/11] lg:aspect-[16/9]">
            <img
              src={imagery.hero}
              alt="Minimal workspace with a laptop, books, and soft natural light"
              class="h-full w-full object-cover object-center"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption class="absolute inset-x-4 bottom-4 flex items-center justify-between gap-4 rounded-2xl border border-white/40 bg-white/55 px-4 py-3 text-[12px] font-medium text-[#424245] shadow-sm backdrop-blur-xl md:inset-x-6 md:bottom-6 md:px-5">
            <span>Quiet interfaces. Deliberate engineering.</span>
            <span class="hidden text-[#6e6e73] sm:inline">Design · Build · Refine</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Capabilities -->
    <section class="bg-white px-5 py-20 sm:px-8 md:py-28">
      <div class="mx-auto max-w-[1180px]">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
          <div class="max-w-xl">
            <p class="mb-4 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#86868b]">What I do</p>
            <h2 class="text-balance text-[clamp(2.4rem,5vw,4.6rem)] font-semibold leading-[0.98] tracking-[-0.045em] text-[#1d1d1f]">
              One partner from first idea to production.
            </h2>
          </div>

          <div class="grid gap-9 sm:grid-cols-2 sm:gap-x-12 sm:gap-y-12 lg:pt-2">
            <div>
              <span class="mb-3 block text-[13px] font-semibold text-[#1d1d1f]">01</span>
              <h3 class="mb-2 text-xl font-semibold tracking-[-0.025em] text-[#1d1d1f]">Product direction</h3>
              <p class="text-[17px] leading-[1.55] text-[#6e6e73]">Clarify the user journey, content hierarchy, and technical shape before implementation begins.</p>
            </div>
            <div>
              <span class="mb-3 block text-[13px] font-semibold text-[#1d1d1f]">02</span>
              <h3 class="mb-2 text-xl font-semibold tracking-[-0.025em] text-[#1d1d1f]">Design engineering</h3>
              <p class="text-[17px] leading-[1.55] text-[#6e6e73]">Turn visual intent into responsive interfaces with careful typography, motion, and interaction details.</p>
            </div>
            <div>
              <span class="mb-3 block text-[13px] font-semibold text-[#1d1d1f]">03</span>
              <h3 class="mb-2 text-xl font-semibold tracking-[-0.025em] text-[#1d1d1f]">Web architecture</h3>
              <p class="text-[17px] leading-[1.55] text-[#6e6e73]">Build maintainable Astro and React systems with a bias toward semantic HTML, speed, and longevity.</p>
            </div>
            <div>
              <span class="mb-3 block text-[13px] font-semibold text-[#1d1d1f]">04</span>
              <h3 class="mb-2 text-xl font-semibold tracking-[-0.025em] text-[#1d1d1f]">Performance refinement</h3>
              <p class="text-[17px] leading-[1.55] text-[#6e6e73]">Profile real bottlenecks, reduce unnecessary JavaScript, and keep Core Web Vitals in the green.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Selected Work -->
    <section class="px-5 py-24 sm:px-8 md:py-36">
      <div class="mx-auto max-w-[1280px]">
        <div class="mb-14 flex items-end justify-between gap-8 md:mb-20">
          <div>
            <p class="mb-4 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#86868b]">Selected work</p>
            <h2 class="text-[clamp(2.7rem,5.5vw,5rem)] font-semibold leading-none tracking-[-0.045em] text-[#1d1d1f]">Built with intent.</h2>
          </div>
          <a href="/work" class="hidden items-center gap-1 text-[17px] font-medium text-[#0066cc] md:inline-flex">
            See all work <span aria-hidden="true">›</span>
          </a>
        </div>

        <div class="space-y-24 md:space-y-36">
          <article class="group">
            <a href="/work/fintech-platform" class="block overflow-hidden rounded-[24px] bg-[#e8e8ed] md:rounded-[30px]">
              <div class="aspect-[4/3] md:aspect-[16/9]">
                <img
                  src={imagery.product}
                  alt="Minimal desk setup with laptop and accessories"
                  class="hover-scale-img h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>
            <div class="mt-7 grid gap-5 md:grid-cols-[1fr_auto] md:items-start md:gap-12">
              <div class="max-w-2xl">
                <p class="mb-2 text-[13px] font-semibold uppercase tracking-[0.12em] text-[#86868b]">Product platform</p>
                <h3 class="text-[clamp(2rem,4vw,3.35rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-[#1d1d1f] transition-colors group-hover:text-[#0066cc]">Fintech Platform</h3>
                <p class="mt-4 max-w-xl text-[17px] leading-[1.55] text-[#6e6e73]">A scalable transactional experience shaped around clear information hierarchy, dependable performance, and confident interaction states.</p>
              </div>
              <span class="text-[14px] font-medium text-[#6e6e73]">2026</span>
            </div>
          </article>

          <article class="grid items-start gap-8 md:grid-cols-12 md:gap-10 lg:gap-16">
            <div class="order-2 md:order-1 md:col-span-5 md:pt-16 lg:pt-24">
              <p class="mb-3 text-[13px] font-semibold uppercase tracking-[0.12em] text-[#86868b]">Commerce systems</p>
              <h3 class="text-[clamp(2rem,4vw,3.5rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-[#1d1d1f]">Global Retail</h3>
              <p class="mt-5 text-[17px] leading-[1.58] text-[#6e6e73]">A commerce architecture focused on fast discovery, low-friction purchasing, and a design system that can expand without visual drift.</p>
              <a href="/work/global-retail" class="mt-7 inline-flex items-center gap-1 text-[17px] font-medium text-[#0066cc]">
                Explore the project <span aria-hidden="true">›</span>
              </a>
            </div>

            <a href="/work/global-retail" class="order-1 block overflow-hidden rounded-[24px] bg-[#e8e8ed] md:order-2 md:col-span-7 md:rounded-[30px]">
              <div class="aspect-[4/5] md:aspect-[5/4]">
                <img
                  src={imagery.studio}
                  alt="Premium minimalist office interior with natural materials"
                  class="hover-scale-img h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>
          </article>
        </div>

        <a href="/work" class="mt-14 inline-flex items-center gap-1 text-[17px] font-medium text-[#0066cc] md:hidden">
          See all work <span aria-hidden="true">›</span>
        </a>
      </div>
    </section>

    <!-- Dark feature -->
    <section class="dark-env bg-black px-5 py-24 text-white sm:px-8 md:py-36">
      <div class="mx-auto max-w-[1180px]">
        <div class="mx-auto max-w-4xl text-center">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#a1a1a6]">Design principle</p>
          <h2 class="text-balance text-[clamp(3rem,7vw,6.8rem)] font-semibold leading-[0.94] tracking-[-0.052em] text-white">
            Less interface.<br />More clarity.
          </h2>
          <p class="mx-auto mt-8 max-w-2xl text-balance text-[clamp(1.1rem,2vw,1.45rem)] leading-[1.5] tracking-[-0.015em] text-[#a1a1a6]">
            The best interaction is often the one users never have to think about. Every layer should earn its place.
          </p>
        </div>

        <div class="mt-16 grid gap-px overflow-hidden rounded-[28px] bg-[#2c2c2e] md:mt-24 md:grid-cols-3">
          <div class="bg-[#111113] p-8 md:p-10">
            <span class="mb-12 block text-[13px] font-semibold text-[#86868b]">01</span>
            <h3 class="text-2xl font-semibold tracking-[-0.03em] text-white">Content first</h3>
            <p class="mt-3 text-[16px] leading-[1.55] text-[#a1a1a6]">Structure and hierarchy lead. Decoration follows only when it improves understanding.</p>
          </div>
          <div class="bg-[#111113] p-8 md:p-10">
            <span class="mb-12 block text-[13px] font-semibold text-[#86868b]">02</span>
            <h3 class="text-2xl font-semibold tracking-[-0.03em] text-white">Materials with purpose</h3>
            <p class="mt-3 text-[16px] leading-[1.55] text-[#a1a1a6]">Translucency and depth are reserved for navigation and controls where spatial context matters.</p>
          </div>
          <div class="bg-[#111113] p-8 md:p-10">
            <span class="mb-12 block text-[13px] font-semibold text-[#86868b]">03</span>
            <h3 class="text-2xl font-semibold tracking-[-0.03em] text-white">Motion with restraint</h3>
            <p class="mt-3 text-[16px] leading-[1.55] text-[#a1a1a6]">Fast, interruptible transitions support orientation instead of competing for attention.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="bg-white px-5 py-24 sm:px-8 md:py-36">
      <div class="mx-auto max-w-[1180px]">
        <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
          <div class="max-w-lg">
            <p class="mb-4 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#86868b]">Process</p>
            <h2 class="text-balance text-[clamp(2.6rem,5vw,4.7rem)] font-semibold leading-[0.98] tracking-[-0.045em] text-[#1d1d1f]">From uncertainty to a production-ready system.</h2>
          </div>

          <div class="divide-y divide-[#d2d2d7] border-y border-[#d2d2d7]">
            <div class="grid gap-4 py-8 sm:grid-cols-[54px_1fr] md:py-10">
              <span class="text-[13px] font-semibold text-[#86868b]">01</span>
              <div>
                <h3 class="text-2xl font-semibold tracking-[-0.03em] text-[#1d1d1f]">Discover</h3>
                <p class="mt-2 max-w-xl text-[17px] leading-[1.55] text-[#6e6e73]">Define the problem, constraints, users, content, and technical requirements before choosing solutions.</p>
              </div>
            </div>
            <div class="grid gap-4 py-8 sm:grid-cols-[54px_1fr] md:py-10">
              <span class="text-[13px] font-semibold text-[#86868b]">02</span>
              <div>
                <h3 class="text-2xl font-semibold tracking-[-0.03em] text-[#1d1d1f]">Design & build</h3>
                <p class="mt-2 max-w-xl text-[17px] leading-[1.55] text-[#6e6e73]">Prototype in the browser, establish the system, and implement responsive behavior alongside visual decisions.</p>
              </div>
            </div>
            <div class="grid gap-4 py-8 sm:grid-cols-[54px_1fr] md:py-10">
              <span class="text-[13px] font-semibold text-[#86868b]">03</span>
              <div>
                <h3 class="text-2xl font-semibold tracking-[-0.03em] text-[#1d1d1f]">Refine & ship</h3>
                <p class="mt-2 max-w-xl text-[17px] leading-[1.55] text-[#6e6e73]">Validate accessibility, performance, responsive behavior, and the small details that determine how polished a product feels.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-5 py-24 sm:px-8 md:py-32">
      <div class="mx-auto max-w-[820px]">
        <div class="mb-14 text-center">
          <p class="mb-4 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#86868b]">FAQ</p>
          <h2 class="text-[clamp(2.5rem,5vw,4.4rem)] font-semibold leading-none tracking-[-0.045em] text-[#1d1d1f]">A few useful answers.</h2>
          <p class="mx-auto mt-5 max-w-xl text-[17px] leading-[1.55] text-[#6e6e73]">Everything you need to know about working together.</p>
        </div>
        <FaqAccordion client:load />
      </div>
    </section>

    <!-- Final CTA -->
    <section class="bg-white px-5 py-28 text-center sm:px-8 md:py-40">
      <div class="mx-auto max-w-4xl">
        <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.14em] text-[#86868b]">Have something ambitious in mind?</p>
        <h2 class="text-balance text-[clamp(3rem,7vw,6.7rem)] font-semibold leading-[0.94] tracking-[-0.052em] text-[#1d1d1f]">
          Let’s make it feel inevitable.
        </h2>
        <p class="mx-auto mt-7 max-w-2xl text-balance text-[clamp(1.1rem,2vw,1.4rem)] leading-[1.5] text-[#6e6e73]">
          Bring the problem. I’ll help shape the experience, the system, and the implementation.
        </p>
        <div class="mt-9">
          <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'rounded-full px-8' })}>
            Start a conversation
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
