---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { FaqAccordion } from '../components/interactive/FaqAccordion';
---

<Layout title="Premium Web Development Agency | Engineering Precision">
  <SiteHeader slot="header" />

  <main class="flex flex-col">
    <!-- Hero (Neutral Canvas, Asymmetrical, Typography-led) -->
    <section class="relative pt-40 pb-20 md:pt-56 md:pb-32 px-4 md:px-8 bg-background overflow-hidden">
      <div class="container mx-auto max-w-[1440px]">
        <div class="flex flex-col md:flex-row justify-between items-start gap-12">

          <div class="max-w-3xl z-10">
            <h1 class="text-display-1 text-foreground mb-8 text-balance">
              We engineer scalable <br class="hidden lg:block"/> digital platforms.
            </h1>
            <div class="max-w-xl">
              <p class="text-xl text-muted-foreground leading-relaxed mb-10 text-balance">
                Partner with a technical agency that understands business outcomes. From high-performance marketing sites to complex web applications, we build software that scales natively.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-full bg-primary px-8 text-base font-medium text-primary-foreground transition-transform hover:bg-primary/90">
                  Discuss Your Project
                </a>
              </div>
            </div>
          </div>

          <!-- Hero abstract context (no glass, just a subtle blue accent) -->
          <div class="relative w-full md:w-1/3 flex justify-end">
            <div class="hidden lg:block absolute -right-20 -top-20 w-[400px] h-[400px] rounded-full gradient-blue-soft blur-[100px] opacity-60"></div>
          </div>

        </div>

        <!-- Hero Image (Large Image Focal Point) -->
        <div class="mt-20 md:mt-32 w-full aspect-[16/9] lg:aspect-[21/9] rounded-2xl md:rounded-[32px] overflow-hidden bg-white shadow-sm border border-border relative">
          <img src="/images/demo_marketing.png" alt="Premium marketing platform preview" class="w-full h-full object-cover" />

          <!-- Contextual glass overlay anchored spatially -->
          <div class="absolute bottom-6 left-6 md:bottom-10 md:left-10 glass-regular p-4 md:p-6 rounded-xl md:rounded-2xl max-w-sm">
            <p class="text-sm font-medium text-foreground">Global Reach</p>
            <p class="text-xs text-muted-foreground mt-1">Engineered for a sub-200ms TTFB worldwide via edge infrastructure.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Capabilities / Trust -->
    <section class="py-20 md:py-32 bg-white px-4 md:px-8">
      <div class="container mx-auto max-w-[1440px]">
        <div class="flex flex-col md:flex-row justify-between gap-12 md:gap-24">
          <div class="md:w-1/3">
            <h2 class="text-display-3 text-foreground mb-4">Core Capabilities</h2>
            <p class="text-muted-foreground leading-relaxed">Trusted by engineering teams and design leaders to deliver the uncompromising quality they expect.</p>
          </div>
          <div class="md:w-2/3 grid grid-cols-2 md:grid-cols-4 gap-8">
            <div class="flex flex-col gap-2">
              <span class="text-sm font-semibold text-foreground tracking-wide">01</span>
              <span class="text-base text-muted-foreground">Frontend Architecture</span>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-sm font-semibold text-foreground tracking-wide">02</span>
              <span class="text-base text-muted-foreground">Design Engineering</span>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-sm font-semibold text-foreground tracking-wide">03</span>
              <span class="text-base text-muted-foreground">Performance Audits</span>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-sm font-semibold text-foreground tracking-wide">04</span>
              <span class="text-base text-muted-foreground">Design Systems</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Selected Work (Editorial layout) -->
    <section class="py-24 md:py-40 bg-background px-4 md:px-8">
      <div class="container mx-auto max-w-[1440px]">
        <div class="flex justify-between items-end mb-16 md:mb-24">
          <h2 class="text-display-2 text-foreground">Selected Work</h2>
          <a href="/work" class="hidden md:block text-sm font-medium text-primary hover:underline underline-offset-4">View All Projects</a>
        </div>

        <div class="flex flex-col gap-24 md:gap-40">
          <!-- Large Project 1 -->
          <div class="group relative flex flex-col md:flex-row gap-8 md:gap-16 items-center">
            <div class="w-full md:w-2/3 aspect-[4/3] rounded-2xl md:rounded-[32px] overflow-hidden bg-white border border-border shadow-sm">
              <img src="/images/demo_webapp.png" alt="Custom Web Application" class="w-full h-full object-cover transition-transform duration-700 ease-out-strong group-hover:scale-105" />
            </div>
            <div class="w-full md:w-1/3 flex flex-col gap-4">
              <h3 class="text-2xl md:text-3xl font-medium text-foreground">Fintech Platform</h3>
              <p class="text-muted-foreground leading-relaxed">Scalable transactional architecture handling robust data elements with sub-100ms response times.</p>
              <div class="h-[1px] w-full bg-border my-4"></div>
              <p class="text-sm text-foreground uppercase tracking-wider">Web Application</p>
            </div>
          </div>

          <!-- Offset Project 2 -->
          <div class="group relative flex flex-col md:flex-row-reverse gap-8 md:gap-16 items-center md:pl-32">
            <div class="w-full md:w-1/2 aspect-[4/5] md:aspect-[3/4] rounded-2xl md:rounded-[32px] overflow-hidden bg-white border border-border shadow-sm">
              <img src="/images/demo_ecommerce.png" alt="E-commerce Experience" class="w-full h-full object-cover transition-transform duration-700 ease-out-strong group-hover:scale-105" />
            </div>
            <div class="w-full md:w-1/2 flex flex-col gap-4">
              <h3 class="text-2xl md:text-3xl font-medium text-foreground">Global Retail</h3>
              <p class="text-muted-foreground leading-relaxed">Headless commerce architecture serving millions of monthly active users, engineered for lightning-fast cart interactions and robust product discovery.</p>
              <div class="h-[1px] w-full bg-border my-4"></div>
              <p class="text-sm text-foreground uppercase tracking-wider">E-Commerce</p>
            </div>
          </div>
        </div>

        <div class="mt-16 md:hidden">
          <a href="/work" class="text-sm font-medium text-primary hover:underline underline-offset-4">View All Projects</a>
        </div>
      </div>
    </section>

    <!-- Services + Differentiation (Asymmetrical textual composition) -->
    <section class="py-24 md:py-40 bg-white px-4 md:px-8 border-y border-border">
      <div class="container mx-auto max-w-[1440px]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
          <div class="lg:col-span-5">
            <h2 class="text-display-3 text-foreground mb-8 text-balance">
              Design engineered for business outcomes.
            </h2>
            <p class="text-lg text-muted-foreground leading-relaxed text-balance">
              We do not just paint pixels. We build foundational design systems and robust architectures that allow your product to scale seamlessly without accruing technical debt.
            </p>
          </div>
          <div class="lg:col-span-1 hidden lg:block"></div>
          <div class="lg:col-span-6 flex flex-col gap-12">
            <div>
              <h3 class="text-xl font-medium text-foreground mb-3">Web Engineering</h3>
              <p class="text-muted-foreground leading-relaxed">Complex React and Astro applications tailored for high performance and scalability. We choose the right tool for the job, favoring standard HTML/CSS over heavy JS where appropriate.</p>
            </div>
            <div class="h-[1px] w-full bg-border"></div>
            <div>
              <h3 class="text-xl font-medium text-foreground mb-3">Performance Tuning</h3>
              <p class="text-muted-foreground leading-relaxed">Audits and refactoring to achieve perfect Core Web Vitals and lightning-fast load times. We optimize everything from network requests to render cycles.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Case Study (Dark Environment) -->
    <section class="dark-env py-32 bg-black px-4 md:px-8 text-white relative">
      <!-- Subtle optical reflection in the dark env -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(100,210,255,0.05)_0%,transparent_50%)] pointer-events-none"></div>

      <div class="container mx-auto max-w-[1440px] relative z-10">
        <div class="flex flex-col md:flex-row gap-12 justify-between items-center mb-16">
          <h2 class="text-display-2 text-balance max-w-2xl">Redefining digital banking experiences.</h2>
          <a href="/work/fintech-platform" class="glass-regular px-6 py-3 rounded-full text-sm font-medium flex-shrink-0 transition-transform hover:bg-white/10 text-white">
            Read Case Study
          </a>
        </div>

        <div class="w-full aspect-video rounded-2xl md:rounded-[32px] overflow-hidden bg-surface relative group">
          <img src="/images/demo_webapp.png" alt="Banking Case Study preview" class="w-full h-full object-cover opacity-80 mix-blend-screen" />
        </div>
      </div>
    </section>

    <!-- Philosophy (Minimalist Typography) -->
    <section class="py-32 md:py-48 bg-background px-4">
      <div class="container mx-auto max-w-4xl text-center">
        <h2 class="text-display-2 text-foreground leading-tight text-balance">
          The details are not the details. <br class="hidden md:block" />They make the design.
        </h2>
        <p class="text-muted-foreground mt-8 text-xl leading-relaxed max-w-2xl mx-auto">
          Our philosophy is simple: build interfaces where every invisible detail compounds into something that feels inevitably correct.
        </p>
      </div>
    </section>

    <!-- Process & Technical Capabilities -->
    <section class="py-24 md:py-40 bg-white px-4 md:px-8 border-t border-border">
      <div class="container mx-auto max-w-[1440px]">
        <div class="mb-20 max-w-3xl">
          <h2 class="text-display-3 text-foreground mb-6">How we build.</h2>
          <p class="text-lg text-muted-foreground">A deterministic approach to software engineering, ensuring quality from the first line of code to the final production deployment.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16">
          <div class="flex flex-col">
            <span class="text-sm text-muted-foreground tracking-widest mb-4 block">01</span>
            <div class="h-[1px] w-full bg-border mb-8"></div>
            <h3 class="text-xl font-medium text-foreground mb-4">Discovery & Architecture</h3>
            <p class="text-muted-foreground leading-relaxed">We map out technical requirements, select the optimal tech stack, and define the data flow before any visual work begins.</p>
          </div>
          <div class="flex flex-col">
            <span class="text-sm text-muted-foreground tracking-widest mb-4 block">02</span>
            <div class="h-[1px] w-full bg-border mb-8"></div>
            <h3 class="text-xl font-medium text-foreground mb-4">Design Engineering</h3>
            <p class="text-muted-foreground leading-relaxed">Design and development happen in parallel. We prototype interactively to guarantee the final implementation matches the vision.</p>
          </div>
          <div class="flex flex-col">
            <span class="text-sm text-muted-foreground tracking-widest mb-4 block">03</span>
            <div class="h-[1px] w-full bg-border mb-8"></div>
            <h3 class="text-xl font-medium text-foreground mb-4">Deployment & Scale</h3>
            <p class="text-muted-foreground leading-relaxed">Rigorous QA, performance profiling, and accessibility audits precede a seamless rollout to production infrastructure.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Client Fit & FAQ -->
    <section class="py-24 md:py-32 bg-background px-4 md:px-8 border-t border-border">
      <div class="container mx-auto max-w-[800px]">
        <div class="mb-16">
          <h2 class="text-display-3 text-foreground mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground">Everything you need to know about partnering with us.</p>
        </div>

        <div>
          <FaqAccordion client:load />
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-32 md:py-48 bg-white px-4 md:px-8 text-center border-t border-border">
      <div class="container mx-auto max-w-3xl">
        <h2 class="text-display-2 text-foreground mb-8 text-balance">
          Ready to build?
        </h2>
        <p class="text-xl text-muted-foreground mb-12 text-balance">
          Let's discuss how we can engineer your next digital platform.
        </p>
        <a href="/contact" class="inline-flex h-14 items-center justify-center rounded-full bg-primary px-10 text-lg font-medium text-primary-foreground transition-transform hover:bg-primary/90">
          Start a Conversation
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
