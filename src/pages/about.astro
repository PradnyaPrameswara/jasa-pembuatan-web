---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { buttonVariants } from '../components/ui/button';

const aboutImage = 'https://images.unsplash.com/photo-1746021451691-4385f318ec13?auto=format&fit=crop&q=84&w=2200';

const skills = ['HTML', 'TypeScript', 'Astro', 'React', 'REST API', 'SQL', 'CSS', 'Python'];
const certifications = ['Frontend Developer (React)', 'REST API (Intermediate)', 'CSS (Basic)', 'SQL (Intermediate)', 'Python (Basic)'];
---

<Layout
  title="About | Anak Agung Gede Pradnya Prameswara"
  description="Fresh Informatics Education graduate from Universitas Pendidikan Ganesha and Fullstack Web Developer based in Gianyar, Bali."
>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1180px]">
      <section class="grid gap-12 pb-24 md:grid-cols-12 md:items-end md:pb-32">
        <div class="md:col-span-7">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-cyan-spectrum/85">About</p>
          <h1 class="text-balance text-[clamp(3.7rem,8vw,7.1rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">
            Fullstack development grounded in clear, maintainable systems.
          </h1>
          <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">
            I am Anak Agung Gede Pradnya Prameswara, a recent Informatics Education graduate from Universitas Pendidikan Ganesha with a strong interest in fullstack web development and software engineering.
          </p>
        </div>

        <figure class="media-shell overflow-hidden rounded-[28px] p-2 md:col-span-5 md:rounded-[34px] md:p-3">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[22px] md:aspect-[5/4] md:rounded-[27px]">
            <img src={aboutImage} alt="Bright professional workspace for focused software development" class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_58%,rgba(5,10,48,.26)_100%)]"></div>
          </div>
        </figure>
      </section>

      <section class="grid gap-5 md:grid-cols-2">
        <article class="glass-panel rounded-[28px] p-7 md:p-10">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">01 · Frontend</p>
          <h2 class="mt-6 text-[clamp(2.2rem,4vw,3.7rem)] font-semibold leading-[1] tracking-[-0.05em] text-white">Structured, responsive interfaces.</h2>
          <p class="mt-6 text-[17px] leading-[1.66] text-white/66">
            I focus on intuitive user interfaces built from reusable components, with an emphasis on clean architecture, responsive behavior, and maintainability.
          </p>
        </article>

        <article class="glass-panel rounded-[28px] p-7 md:p-10">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">02 · Backend</p>
          <h2 class="mt-6 text-[clamp(2.2rem,4vw,3.7rem)] font-semibold leading-[1] tracking-[-0.05em] text-white">APIs, data, and application workflows.</h2>
          <p class="mt-6 text-[17px] leading-[1.66] text-white/66">
            My backend experience includes API development, database management, and designing application workflows that support complete web applications.
          </p>
        </article>
      </section>

      <section class="grid gap-10 py-24 md:grid-cols-12 md:py-32">
        <div class="md:col-span-4">
          <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Experience</p>
        </div>
        <div class="space-y-0 md:col-span-8">
          <div class="border-t border-white/14 py-7">
            <p class="text-[12px] font-semibold text-white/42">June 2026 — Present</p>
            <h3 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-white">Web Developer · Widhi Asih Bali Export</h3>
            <p class="mt-2 text-[16px] leading-[1.6] text-white/62">Current professional web development experience.</p>
          </div>
          <div class="border-y border-white/14 py-7">
            <p class="text-[12px] font-semibold text-white/42">September 2025 — December 2025</p>
            <h3 class="mt-2 text-xl font-semibold tracking-[-0.025em] text-white">Informatics Teaching Intern · SMP Negeri 6 Singaraja</h3>
            <p class="mt-2 text-[16px] leading-[1.6] text-white/62">Teaching internship experience in Singaraja, Bali, Indonesia.</p>
          </div>
        </div>
      </section>

      <section class="grid gap-5 md:grid-cols-2">
        <article class="glass-panel rounded-[28px] p-7 md:p-9">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Education</p>
          <h2 class="mt-5 text-2xl font-semibold tracking-[-0.035em] text-white">Universitas Pendidikan Ganesha</h2>
          <p class="mt-3 text-[16px] leading-[1.6] text-white/66">Bachelor's degree · Technical Teacher Education · 2022–2026</p>
          <p class="mt-6 text-[14px] text-white/50">SMAN 1 Blahbatuh · 2018–2022</p>
        </article>

        <article class="glass-panel rounded-[28px] p-7 md:p-9">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Skills</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {skills.map((skill) => <span class="rounded-full border border-white/14 bg-white/[0.06] px-3 py-1.5 text-[13px] font-medium text-white/76">{skill}</span>)}
          </div>
          <p class="mt-7 text-[12px] font-semibold uppercase tracking-[0.14em] text-white/42">Certifications</p>
          <ul class="mt-3 space-y-2 text-[14px] text-white/64">
            {certifications.map((certification) => <li>{certification}</li>)}
          </ul>
        </article>
      </section>

      <section class="glass-panel mt-24 rounded-[30px] p-7 md:mt-32 md:p-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Academic project & publication</p>
        <h2 class="mt-5 max-w-4xl text-[clamp(2.2rem,4vw,3.8rem)] font-semibold leading-[1] tracking-[-0.05em] text-white">Development of a Large Language Model-Based Diagnostic Assessment System for Detecting Students' Initial Abilities</h2>
        <p class="mt-6 max-w-3xl text-[17px] leading-[1.66] text-white/66">During university, I developed a diagnostic assessment system designed to identify students' initial abilities and apply software engineering to a practical education-sector problem.</p>
      </section>

      <section class="glass-panel mt-5 rounded-[30px] px-6 py-14 text-center sm:px-10 md:py-20">
        <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Current goal</p>
        <h2 class="mx-auto mt-4 max-w-3xl text-[clamp(2.8rem,5vw,5.2rem)] font-semibold leading-[0.96] tracking-[-0.055em] text-white">Open to full-time software development opportunities.</h2>
        <p class="mx-auto mt-6 max-w-2xl text-[17px] leading-[1.62] text-white/64">I am currently seeking roles as a Fullstack Developer, Frontend Developer, or Backend Engineer where I can contribute to efficient, scalable, and impactful software.</p>
        <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'mt-8' })}>Get in touch</a>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
