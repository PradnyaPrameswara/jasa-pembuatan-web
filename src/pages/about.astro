---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { buttonVariants } from '../components/ui/button';
---

<Layout 
  title="About | Pradnya"
  description="Learn about Pradnya, an independent web engineering and design firm based in Indonesia, partnering with ambitious companies worldwide."
>
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background">
    <div class="container mx-auto max-w-3xl">
      <h1 data-motion="hero-headline" class="text-display-2 mb-6 text-foreground text-balance">About the Agency</h1>
      <p data-motion="hero-copy" class="text-xl text-muted-foreground mb-16 leading-relaxed text-balance">
        We are an independent web engineering and design firm based in Indonesia, partnering with ambitious companies worldwide.
      </p>

      <div class="space-y-16">
        <section>
          <div class="h-[1px] w-full bg-border mb-8"></div>
          <h2 class="text-xl font-medium mb-4 text-foreground">Our Philosophy</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            We believe that the best digital products sit at the intersection of rigorous technical engineering and premium, restrained design. We do not chase trends or rely on heavy, unnecessary client-side frameworks when a simpler, more robust architecture will serve the business better.
          </p>
        </section>

        <section>
          <div class="h-[1px] w-full bg-border mb-8"></div>
          <h2 class="text-xl font-medium mb-4 text-foreground">Technical Precision</h2>
          <p class="text-muted-foreground text-lg leading-relaxed">
            Every project we ship is held to the highest standards of accessibility, performance, and maintainability. We build systems that internal teams can actually scale, utilizing technologies like Astro for static perfection and React for targeted interactivity.
          </p>
        </section>

        <section class="border-t border-border pt-16 mt-20 text-center">
          <h2 class="text-display-3 mb-6 text-foreground">Ready to start?</h2>
          <p class="text-muted-foreground mb-8 text-lg">
            We take on a limited number of projects per quarter to ensure execution quality.
          </p>
          <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg' })}>
            Discuss Your Project
          </a>
        </section>
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
