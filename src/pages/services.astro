---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { buttonVariants } from '../components/ui/button';

const studioImage = 'https://images.unsplash.com/photo-1761123261084-53c40fe1e607?auto=format&fit=crop&q=84&w=2200';

const services = [
  {
    number: '01',
    title: 'Website Design & Development',
    description: 'Premium marketing websites shaped around strong hierarchy, refined typography, and an Astro-first implementation that stays fast on real devices.',
    capabilities: ['Frontend engineering', 'Performance optimization', 'SEO foundations', 'CMS integration']
  },
  {
    number: '02',
    title: 'Web Applications',
    description: 'Focused product interfaces for complex workflows, with React introduced only where genuine client-side state and interaction require it.',
    capabilities: ['Product architecture', 'API integration', 'Stateful interfaces', 'Accessibility']
  },
  {
    number: '03',
    title: 'E-commerce',
    description: 'Commerce systems built around discovery, fast purchasing paths, resilient integrations, and an interface language that scales with the catalog.',
    capabilities: ['Headless commerce', 'Checkout flows', 'Payment integration', 'Conversion UX']
  },
  {
    number: '04',
    title: 'Redesign & Optimization',
    description: 'A structured audit and rebuild process for products that need stronger visual coherence, better performance, and a cleaner technical foundation.',
    capabilities: ['Accessibility audit', 'Core Web Vitals', 'Design systems', 'Architecture cleanup']
  }
];
---

<Layout
  title="Services | Pradnya"
  description="Explore Pradnya's web engineering, performance tuning, e-commerce, and design system capabilities."
>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1180px]">
      <section class="grid gap-12 pb-24 md:grid-cols-12 md:items-end md:pb-32">
        <div class="md:col-span-7">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-cyan-spectrum/85">Services</p>
          <h1 class="text-balance text-[clamp(3.7rem,8vw,7.1rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">
            Design and engineering, treated as one system.
          </h1>
          <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">
            From first structure to final polish, the work stays focused on clarity, performance, and a product language that feels deliberate at every breakpoint.
          </p>
          <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'mt-8' })}>Discuss your project</a>
        </div>

        <figure class="media-shell overflow-hidden rounded-[28px] p-2 md:col-span-5 md:rounded-[34px] md:p-3">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[22px] md:aspect-[5/4] md:rounded-[27px]">
            <img src={studioImage} alt="Clean UX design studio workspace with monitor, tablet, and ergonomic chair" class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_55%,rgba(5,10,48,.32)_100%)]"></div>
          </div>
        </figure>
      </section>

      <section class="grid gap-5 md:grid-cols-2" aria-label="Service capabilities">
        {services.map((service) => (
          <article class="glass-panel flex min-h-[340px] flex-col justify-between rounded-[28px] p-7 md:p-9">
            <div>
              <div class="flex items-center justify-between gap-4">
                <span class="text-[12px] font-semibold text-cyan-spectrum/78">{service.number}</span>
                <span class="h-px flex-1 bg-white/12"></span>
              </div>
              <h2 class="mt-9 text-[clamp(2rem,3.2vw,3.2rem)] font-semibold leading-[1.02] tracking-[-0.045em] text-white">{service.title}</h2>
              <p class="mt-5 max-w-xl text-[16px] leading-[1.65] text-white/66">{service.description}</p>
            </div>

            <div class="mt-10 border-t border-white/14 pt-6">
              <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/44">Capabilities</p>
              <ul class="grid gap-3 sm:grid-cols-2">
                {service.capabilities.map((capability) => (
                  <li class="flex items-center gap-2.5 text-[14px] text-white/72">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan-spectrum"></span>
                    {capability}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <section class="grid gap-8 py-24 md:grid-cols-[.8fr_1.2fr] md:items-start md:py-32">
        <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">How I work</p>
        <div>
          <h2 class="max-w-4xl text-[clamp(2.7rem,5vw,5rem)] font-semibold leading-[0.97] tracking-[-0.055em] text-white">Small surface area. High attention to detail.</h2>
          <p class="mt-6 max-w-2xl text-[17px] leading-[1.65] text-white/66">The stack stays intentionally lean: Astro for the rendering layer, TypeScript throughout, React islands only when interaction needs state, and shadcn primitives for reusable interactive controls.</p>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
