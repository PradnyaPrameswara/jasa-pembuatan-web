---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { buttonVariants } from '../components/ui/button';

const studioImage = 'https://images.unsplash.com/photo-1761123261084-53c40fe1e607?auto=format&fit=crop&q=84&w=2200';

const capabilities = [
  {
    number: '01',
    title: 'Frontend Development',
    description: 'Responsive, structured interfaces built with reusable components and a focus on maintainability and user experience.',
    skills: ['HTML', 'TypeScript', 'Astro', 'React']
  },
  {
    number: '02',
    title: 'Fullstack Web Development',
    description: 'End-to-end web application development covering interface structure, application logic, APIs, data, and efficient workflows.',
    skills: ['Web applications', 'Reusable architecture', 'Application workflows', 'User-focused solutions']
  },
  {
    number: '03',
    title: 'Backend & API Development',
    description: 'Backend work focused on robust systems, REST APIs, database management, and practical integration between application layers.',
    skills: ['REST API', 'SQL', 'Database management', 'System workflows']
  },
  {
    number: '04',
    title: 'Software Engineering',
    description: 'Software built around clarity, maintainability, responsiveness, and practical solutions to real-world problems.',
    skills: ['Maintainable code', 'Responsive systems', 'Problem solving', 'Clean architecture']
  }
];
---

<Layout
  title="Capabilities | Pradnya Prameswara"
  description="Frontend, fullstack, backend, API, and software engineering capabilities grounded in TypeScript, Astro, REST APIs, and maintainable application architecture."
>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1180px]">
      <section class="grid gap-12 pb-24 md:grid-cols-12 md:items-end md:pb-32">
        <div class="md:col-span-7">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-cyan-spectrum/85">Capabilities</p>
          <h1 class="text-balance text-[clamp(3.7rem,8vw,7.1rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">
            Building complete web applications from interface to backend.
          </h1>
          <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">
            My background combines frontend interface work with API development, database management, and application workflows, with TypeScript and Astro among my core skills.
          </p>
          <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'mt-8' })}>Discuss an opportunity</a>
        </div>

        <figure class="media-shell overflow-hidden rounded-[28px] p-2 md:col-span-5 md:rounded-[34px] md:p-3">
          <div class="relative aspect-[4/3] overflow-hidden rounded-[22px] md:aspect-[5/4] md:rounded-[27px]">
            <img src={studioImage} alt="Modern software development workspace" class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_55%,rgba(5,10,48,.32)_100%)]"></div>
          </div>
        </figure>
      </section>

      <section class="grid gap-5 md:grid-cols-2" aria-label="Development capabilities">
        {capabilities.map((capability) => (
          <article class="glass-panel flex min-h-[340px] flex-col justify-between rounded-[28px] p-7 md:p-9">
            <div>
              <div class="flex items-center justify-between gap-4">
                <span class="text-[12px] font-semibold text-cyan-spectrum/78">{capability.number}</span>
                <span class="h-px flex-1 bg-white/12"></span>
              </div>
              <h2 class="mt-9 text-[clamp(2rem,3.2vw,3.2rem)] font-semibold leading-[1.02] tracking-[-0.045em] text-white">{capability.title}</h2>
              <p class="mt-5 max-w-xl text-[16px] leading-[1.65] text-white/66">{capability.description}</p>
            </div>

            <div class="mt-10 border-t border-white/14 pt-6">
              <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/44">Relevant skills</p>
              <ul class="grid gap-3 sm:grid-cols-2">
                {capability.skills.map((skill) => (
                  <li class="flex items-center gap-2.5 text-[14px] text-white/72">
                    <span class="h-1.5 w-1.5 rounded-full bg-cyan-spectrum"></span>
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <section class="grid gap-8 py-24 md:grid-cols-[.8fr_1.2fr] md:items-start md:py-32">
        <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Technical profile</p>
        <div>
          <h2 class="max-w-4xl text-[clamp(2.7rem,5vw,5rem)] font-semibold leading-[0.97] tracking-[-0.055em] text-white">Frontend foundations with fullstack problem solving.</h2>
          <p class="mt-6 max-w-2xl text-[17px] leading-[1.65] text-white/66">Top skills listed in my CV are HTML, TypeScript, and Astro. I also hold certifications covering React frontend development, REST APIs, SQL, CSS, and Python.</p>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
