---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

const services = [
  {
    title: 'Website Design & Development',
    description: 'We build high-performance marketing websites that communicate technical credibility and drive business outcomes. Every site is built for speed, accessibility, and scale.',
    capabilities: ['Frontend Development', 'Performance Optimization', 'SEO', 'CMS Integration']
  },
  {
    title: 'Web Applications',
    description: 'Complex software requires robust engineering. We architect and build scalable web applications using React and modern server-side technologies.',
    capabilities: ['Architecture', 'API Integration', 'State Management', 'Security']
  },
  {
    title: 'E-commerce',
    description: 'Bespoke e-commerce experiences designed for conversion and built on modern headless commerce platforms.',
    capabilities: ['Headless Shopify', 'Payment Gateways', 'Performance', 'Cart Optimization']
  },
  {
    title: 'Website Redesign & Optimization',
    description: 'We audit, redesign, and refactor existing platforms to meet modern standards of performance, accessibility, and visual quality.',
    capabilities: ['Accessibility Audits', 'Core Web Vitals', 'Design Systems', 'Code Refactoring']
  }
];
---

<Layout title="Services | Premium Web Agency">
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background relative overflow-hidden">
    <div class="container mx-auto max-w-[1000px] relative z-10">
      <h1 data-motion="hero-headline" class="text-display-2 mb-6 text-foreground text-balance">Our Services</h1>
      <p data-motion="hero-copy" class="text-xl text-muted-foreground mb-20 max-w-2xl leading-relaxed text-balance">
        We specialize in engineering robust digital platforms. Our approach combines rigorous technical architecture with premium design execution.
      </p>

      <div class="flex flex-col gap-16 md:gap-24">
        {services.map((service, index) => (
          <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-start">
            <div class="w-full md:w-1/2">
              <div class="h-[1px] w-full bg-border mb-6 block md:hidden"></div>
              <h2 class="text-2xl md:text-3xl font-medium text-foreground mb-4">{service.title}</h2>
              <p class="text-muted-foreground text-lg leading-relaxed">{service.description}</p>
            </div>

            <div class="w-full md:w-1/2">
              <div class="h-[1px] w-full bg-border mb-6"></div>
              <span class="text-sm font-medium text-foreground tracking-wide uppercase block mb-4">Capabilities</span>
              <ul class="flex flex-col gap-3">
                {service.capabilities.map(cap => (
                  <li class="flex items-center gap-3 text-muted-foreground text-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-border"></span>
                    {cap}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
