---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { ContactForm } from '../components/interactive/ContactForm.tsx';

const contactImage = 'https://images.unsplash.com/photo-1684560208006-274881cc4c4b?auto=format&fit=crop&q=84&w=2200';
---

<Layout
  title="Contact | Pradnya"
  description="Partner with Pradnya to build your next digital platform. Contact me to discuss your technical challenges and business goals."
>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1180px]">
      <section class="grid gap-12 md:grid-cols-12 md:items-start md:gap-14 lg:gap-20">
        <div class="md:col-span-5 md:sticky md:top-28">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-cyan-spectrum/85">Contact</p>
          <h1 class="text-balance text-[clamp(3.5rem,7vw,6.4rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">Start with the problem worth solving.</h1>
          <p class="mt-7 max-w-xl text-[clamp(1.05rem,1.8vw,1.3rem)] leading-[1.58] text-white/68">
            Share the product, website, or system you want to improve. I’ll review the context and respond with a practical next step.
          </p>

          <figure class="media-shell mt-10 overflow-hidden rounded-[26px] p-2 md:mt-12 md:rounded-[32px] md:p-3">
            <div class="relative aspect-[4/3] overflow-hidden rounded-[20px] md:rounded-[25px]">
              <img src={contactImage} alt="Organized desk with notebook, keyboard, phone, and planning notes" class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
              <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_58%,rgba(5,10,48,.3)_100%)]"></div>
            </div>
          </figure>

          <div class="mt-8 grid gap-3 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
            <div class="rounded-2xl border border-white/14 bg-white/[0.06] p-4 backdrop-blur-xl">
              <p class="text-[11px] font-semibold uppercase tracking-[0.13em] text-white/42">Response</p>
              <p class="mt-2 text-[15px] font-medium text-white/78">Usually within 24 hours</p>
            </div>
            <div class="rounded-2xl border border-white/14 bg-white/[0.06] p-4 backdrop-blur-xl">
              <p class="text-[11px] font-semibold uppercase tracking-[0.13em] text-white/42">Working mode</p>
              <p class="mt-2 text-[15px] font-medium text-white/78">Bali · Remote worldwide</p>
            </div>
          </div>
        </div>

        <div class="md:col-span-7">
          <div class="glass-panel rounded-[30px] p-5 sm:p-7 md:p-9 lg:p-10">
            <div class="mb-9 border-b border-white/14 pb-7">
              <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/78">Project inquiry</p>
              <h2 class="mt-3 text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[1] tracking-[-0.045em] text-white">Tell me what needs to work better.</h2>
              <p class="mt-4 max-w-2xl text-[16px] leading-[1.62] text-white/60">A concise brief is enough. Scope, timeline, budget, and the current challenge are the most useful details.</p>
            </div>

            <ContactForm client:load />
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
