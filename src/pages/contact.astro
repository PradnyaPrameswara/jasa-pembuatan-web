---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { ContactForm } from '../components/interactive/ContactForm.tsx';
---

<Layout title="Contact | Premium Web Agency">
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background">
    <div class="container mx-auto max-w-3xl">
      <h1 class="text-display-2 mb-6 text-foreground text-balance">Discuss Your Project</h1>
      <p class="text-xl text-muted-foreground mb-16 max-w-2xl leading-relaxed text-balance">
        Tell us about your technical challenges and business goals. We'll get back to you within 24 hours to schedule an initial consultation.
      </p>

      <div class="pt-8 border-t border-border">
        <ContactForm client:load />
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
