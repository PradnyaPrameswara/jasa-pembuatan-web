---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';

const projects = [
  {
    slug: 'fintech-platform',
    title: 'Fintech Platform',
    category: 'Web Application',
    year: '2026',
    description: 'Scalable transactional architecture handling robust data elements with sub-100ms response times.',
    image: '/images/demo_webapp.png'
  },
  {
    slug: 'global-retail',
    title: 'Global Retail',
    category: 'E-commerce',
    year: '2026',
    description: 'Headless commerce architecture serving millions of monthly active users, engineered for lightning-fast cart interactions and robust product discovery.',
    image: '/images/demo_ecommerce.png'
  },
  {
    slug: 'architectural-firm',
    title: 'Architectural Firm',
    category: 'Marketing Website',
    year: '2026',
    description: 'An editorial, highly optimized static site driven by a headless CMS, allowing the firm to effortlessly manage their case studies.',
    image: '/images/demo_marketing.png'
  }
];
---

<Layout title="Work | Premium Web Agency">
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background">
    <div class="container mx-auto max-w-[1440px]">
      <div class="max-w-3xl mb-24">
        <h1 data-motion="hero-headline" class="text-display-2 mb-6 text-foreground text-balance">Selected Work</h1>
        <p data-motion="hero-copy" class="text-xl text-muted-foreground leading-relaxed text-balance">
          Recent projects demonstrating our technical capabilities and design discipline. We build platforms that perform.
        </p>
      </div>

      <div class="flex flex-col gap-32 md:gap-40">
        {projects.map((project, i) => (
          <div class="group flex flex-col gap-6 md:gap-10">
            <a href={`/work/${project.slug}`} class="block w-full overflow-hidden relative bg-surface" style={`border-radius: var(--media-radius-featured); aspect-ratio: ${i === 0 ? '3/2' : i === 1 ? '4/3' : '21/9'}`}>
              <img src={project.image} alt={`${project.title} preview`} class="w-full h-full object-cover object-top hover-scale-img" loading={i === 0 ? 'eager' : 'lazy'} />
            </a>
            <div class="flex flex-col md:flex-row gap-4 md:gap-12 justify-between">
              <div class="max-w-xl">
                <p class="text-sm font-medium tracking-wide text-muted-foreground uppercase mb-3">{project.category}</p>
                <h3 class="text-3xl md:text-4xl font-medium text-foreground mb-4 group-hover:text-primary transition-colors">{project.title}</h3>
                <p class="text-lg text-muted-foreground leading-relaxed">{project.description}</p>
              </div>
              <div class="md:text-right flex-shrink-0">
                <p class="text-sm font-medium text-foreground">{project.year}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
