---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { buttonVariants } from '../../components/ui/button';

import { work } from '../../data/work';

---

<Layout
  title="Experience & Projects | Pradnya Prameswara"
  description="Professional experience, academic software work, and Informatics teaching experience from Pradnya Prameswara's CV."
>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1280px]">
      <section class="grid gap-10 pb-20 md:grid-cols-[1.2fr_.8fr] md:items-end md:pb-28">
        <div class="max-w-4xl">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-cyan-spectrum/85">Experience & projects</p>
          <h1 class="text-balance text-[clamp(2.85rem,8vw,7.2rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">
            Practical experience across web development and education technology.
          </h1>
        </div>
        <div class="md:pb-2">
          <p class="max-w-xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">
            A factual view of my current Web Developer role, university software project, publication, and Informatics teaching internship.
          </p>
          <a href="/contact" class={buttonVariants({ variant: 'secondary', size: 'lg', className: 'mt-7' })}>
            Discuss an opportunity
          </a>
        </div>
      </section>

      <section class="space-y-24 md:space-y-32" aria-label="Experience and selected projects">
        {work.map((project, index) => (
          <article class="group grid gap-7 md:grid-cols-12 md:gap-10 lg:gap-14">
            <a
              href={`/work/${project.slug}`}
              class={`media-shell block overflow-hidden rounded-[30px] p-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200 md:rounded-[36px] md:p-3 ${index % 2 === 1 ? 'md:order-2 md:col-span-7' : 'md:col-span-8'}`}
            >
              <div class="relative aspect-[4/3] overflow-hidden rounded-[24px] bg-white/10 md:aspect-[16/10] md:rounded-[29px]">
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  class="hover-scale-img h-full w-full object-cover object-center"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="1200"
                  height="750"
                />
                <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_55%,rgba(5,10,48,.3)_100%)]"></div>
                <span class="absolute bottom-4 left-4 rounded-full border border-white/25 bg-[#09112c]/70 px-3 py-1.5 text-[11px] font-semibold text-white/90 backdrop-blur-md sm:bottom-6 sm:left-6">Concept illustration</span>
              </div>
            </a>

            <div class={`flex flex-col justify-between py-2 ${index % 2 === 1 ? 'md:order-1 md:col-span-5' : 'md:col-span-4'}`}>
              <div>
                <div class="mb-6 flex items-center justify-between gap-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/48">
                  <span>{project.category}</span>
                  <span>{project.year}</span>
                </div>
                <h2 class="text-[clamp(2.2rem,4vw,4.2rem)] font-semibold leading-[0.98] tracking-[-0.05em] text-white">
                  {project.title}
                </h2>
                <p class="mt-5 text-[17px] leading-[1.62] text-white/66">{project.description}</p>
                <ul aria-label="Focus areas" class="mt-5 flex flex-wrap gap-2">
                  {project.focus.map((area) => <li class="rounded-full border border-white/20 bg-white/[0.06] px-3 py-1.5 text-[12px] text-white/75">{area}</li>)}
                </ul>
              </div>

              <div class="mt-9 border-t border-white/14 pt-5 md:mt-14">
                <p class="text-[12px] font-medium uppercase tracking-[0.12em] text-cyan-spectrum/80">{project.meta}</p>
                <a href={`/work/${project.slug}`} class="mt-4 inline-flex items-center gap-2 rounded-sm text-[15px] font-semibold text-white transition-colors hover:text-cyan-spectrum focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200">
                  View details <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
