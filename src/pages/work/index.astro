---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';

const projects = [
  {
    slug: 'fintech-platform',
    title: 'Fintech Core Application',
    category: 'Web Application',
    year: '2026',
    description: 'A complete overhaul of a legacy fintech dashboard, migrating to a modern React-based architecture with rigorous accessibility standards.',
    image: '/images/demo_webapp.png'
  },
  {
    slug: 'global-retail',
    title: 'Global Retail E-commerce',
    category: 'E-commerce',
    year: '2025',
    description: 'Headless Shopify implementation featuring sub-second page transitions and a custom dynamic checkout flow.',
    image: '/images/demo_ecommerce.png'
  },
  {
    slug: 'architectural-firm',
    title: 'Architectural Firm Portfolio',
    category: 'Marketing Website',
    year: '2025',
    description: 'An editorial, highly optimized static site driven by a headless CMS, allowing the firm to effortlessly manage their case studies.',
    image: '/images/demo_marketing.png'
  }
];
---

<Layout title="Work | Premium Web Agency">
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background">
    <div class="container mx-auto max-w-[1440px]">
      <div class="max-w-3xl mb-24">
        <h1 class="text-display-2 mb-6 text-foreground text-balance">Selected Work</h1>
        <p class="text-xl text-muted-foreground leading-relaxed text-balance">
          Recent projects demonstrating our technical capabilities and design discipline. We build platforms that perform.
        </p>
      </div>

      <div class="flex flex-col gap-32">
        {projects.map((project, index) => (
          <a href={`/work/${project.slug}`} class={`group flex flex-col ${index % 2 !== 0 ? 'md:flex-row-reverse md:pl-32' : 'md:flex-row'} gap-8 md:gap-16 items-center`}>
            <div class={`w-full ${index % 2 !== 0 ? 'md:w-1/2 aspect-[4/5] md:aspect-[3/4]' : 'md:w-2/3 aspect-[4/3]'} rounded-2xl md:rounded-[32px] overflow-hidden bg-white border border-border shadow-sm relative`}>
              <img src={project.image} alt={`${project.title} preview`} class="w-full h-full object-cover transition-transform duration-700 ease-out-strong group-hover:scale-105" loading={index === 0 ? "eager" : "lazy"} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>

            <div class={`w-full ${index % 2 !== 0 ? 'md:w-1/2' : 'md:w-1/3'} flex flex-col gap-4`}>
              <h3 class="text-2xl md:text-3xl font-medium text-foreground group-hover:text-primary transition-colors">{project.title}</h3>
              <p class="text-muted-foreground leading-relaxed">{project.description}</p>
              <div class="h-[1px] w-full bg-border my-4"></div>
              <div class="flex justify-between items-center text-sm text-foreground uppercase tracking-wider">
                <span>{project.category}</span>
                <span>{project.year}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
