---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { buttonVariants } from '../../components/ui/button';

const projects = [
  {
    slug: 'fintech-platform',
    title: 'Fintech Platform',
    category: 'Web Application',
    year: '2026',
    description: 'A high-density transactional product shaped around fast decision-making, clear hierarchy, and dependable interaction patterns.',
    image: 'https://images.unsplash.com/photo-1748439435495-722cc1728b7e?auto=format&fit=crop&q=84&w=2400',
    imageAlt: 'Financial trading workspace with multiple analytics displays',
    meta: 'Product systems · Data UI · Performance'
  },
  {
    slug: 'global-retail',
    title: 'Global Retail',
    category: 'E-Commerce',
    year: '2026',
    description: 'A commerce experience designed around product discovery, frictionless payment, and a system that remains coherent at scale.',
    image: 'https://images.unsplash.com/photo-1742836531244-de8454b8bc06?auto=format&fit=crop&q=84&w=2400',
    imageAlt: 'Minimal contactless payment terminal in a premium retail setting',
    meta: 'Commerce · Checkout · Conversion'
  },
  {
    slug: 'architectural-firm',
    title: 'Architectural Firm',
    category: 'Editorial Website',
    year: '2026',
    description: 'A restrained editorial platform where photography, project narratives, and structural clarity lead the browsing experience.',
    image: 'https://images.unsplash.com/photo-1775735478842-c3bbcf5d2618?auto=format&fit=crop&q=84&w=2400',
    imageAlt: 'Minimal modern architecture facade with horizontal geometric lines',
    meta: 'Editorial · CMS · Art direction'
  }
];
---

<Layout
  title="Selected Work | Pradnya"
  description="Selected web development and design projects engineered by Pradnya. A showcase of technical capabilities and design discipline."
>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1280px]">
      <section class="grid gap-10 pb-20 md:grid-cols-[1.2fr_.8fr] md:items-end md:pb-28">
        <div class="max-w-4xl">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.16em] text-cyan-spectrum/85">Selected work</p>
          <h1 class="text-balance text-[clamp(3.6rem,8vw,7.2rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">
            Digital systems with a clear point of view.
          </h1>
        </div>
        <div class="md:pb-2">
          <p class="max-w-xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">
            Product interfaces, commerce platforms, and editorial websites built to stay fast, legible, and useful as they grow.
          </p>
          <a href="/contact" class={buttonVariants({ variant: 'secondary', size: 'lg', className: 'mt-7' })}>
            Start a project
          </a>
        </div>
      </section>

      <section class="space-y-24 md:space-y-32" aria-label="Selected projects">
        {projects.map((project, index) => (
          <article class="group grid gap-7 md:grid-cols-12 md:gap-10 lg:gap-14">
            <a
              href={`/work/${project.slug}`}
              class={`media-shell block overflow-hidden rounded-[30px] p-2 md:rounded-[36px] md:p-3 ${index % 2 === 1 ? 'md:order-2 md:col-span-7' : 'md:col-span-8'}`}
            >
              <div class="relative aspect-[4/3] overflow-hidden rounded-[24px] bg-white/10 md:aspect-[16/10] md:rounded-[29px]">
                <img
                  src={project.image}
                  alt={project.imageAlt}
                  class="hover-scale-img h-full w-full object-cover object-center"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_55%,rgba(5,10,48,.36)_100%)]"></div>
              </div>
            </a>

            <div class={`flex flex-col justify-between py-2 ${index % 2 === 1 ? 'md:order-1 md:col-span-5' : 'md:col-span-4'}`}>
              <div>
                <div class="mb-6 flex items-center justify-between gap-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/48">
                  <span>{project.category}</span>
                  <span>{project.year}</span>
                </div>
                <h2 class="text-[clamp(2.2rem,4vw,4.2rem)] font-semibold leading-[0.98] tracking-[-0.05em] text-white">
                  {project.title}
                </h2>
                <p class="mt-5 text-[17px] leading-[1.62] text-white/66">{project.description}</p>
              </div>

              <div class="mt-9 border-t border-white/14 pt-5 md:mt-14">
                <p class="text-[12px] font-medium uppercase tracking-[0.12em] text-cyan-spectrum/80">{project.meta}</p>
                <a href={`/work/${project.slug}`} class="mt-4 inline-flex items-center gap-2 text-[15px] font-semibold text-white transition-colors hover:text-cyan-spectrum">
                  View case study <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
