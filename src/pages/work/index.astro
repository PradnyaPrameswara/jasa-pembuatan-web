---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';

const projects = [
  {
    slug: 'fintech-platform',
    title: 'Fintech Platform',
    category: 'Web Application',
    year: '2026',
    description: 'Scalable transactional architecture handling robust data elements with sub-100ms response times.',
    image: '/images/demo_webapp.png'
  },
  {
    slug: 'global-retail',
    title: 'Global Retail',
    category: 'E-commerce',
    year: '2026',
    description: 'Headless commerce architecture serving millions of monthly active users, engineered for lightning-fast cart interactions and robust product discovery.',
    image: '/images/demo_ecommerce.png'
  },
  {
    slug: 'architectural-firm',
    title: 'Architectural Firm',
    category: 'Marketing Website',
    year: '2026',
    description: 'An editorial, highly optimized static site driven by a headless CMS, allowing the firm to effortlessly manage their case studies.',
    image: '/images/demo_marketing.png'
  }
];
---

<Layout title="Work | Premium Web Agency">
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background">
    <div class="container mx-auto max-w-[1440px]">
      <div class="max-w-3xl mb-24">
        <h1 class="text-display-2 mb-6 text-foreground text-balance">Selected Work</h1>
        <p class="text-xl text-muted-foreground leading-relaxed text-balance">
          Recent projects demonstrating our technical capabilities and design discipline. We build platforms that perform.
        </p>
      </div>

      <div class="flex flex-col gap-32">
        <!-- Project 1: Featured -->
        <div class="group flex flex-col gap-6 md:gap-10">
          <a href={`/work/${projects[0].slug}`} class="block w-full lg:w-[85%] aspect-[16/10] md:aspect-[3/2] rounded-xl md:rounded-2xl overflow-hidden relative bg-surface">
            <img src={projects[0].image} alt={`${projects[0].title} preview`} class="w-full h-full object-cover object-top hover-scale-img" loading="eager" />
          </a>
          <div class="flex flex-col md:flex-row gap-4 md:gap-12 justify-between lg:w-[85%]">
            <div class="max-w-xl">
              <p class="text-sm font-medium tracking-wide text-muted-foreground uppercase mb-3">{projects[0].category}</p>
              <h3 class="text-3xl md:text-4xl font-medium text-foreground mb-4 group-hover:text-primary transition-colors">{projects[0].title}</h3>
              <p class="text-lg text-muted-foreground leading-relaxed">{projects[0].description}</p>
            </div>
            <div class="md:text-right flex-shrink-0">
              <p class="text-sm font-medium text-foreground">{projects[0].year}</p>
            </div>
          </div>
        </div>

        <!-- Project 2: Asymmetrical Offset -->
        <div class="group flex flex-col md:flex-row gap-8 md:gap-16 items-start lg:justify-end mt-16 md:mt-0">
          <div class="w-full md:w-[45%] flex flex-col gap-4 md:mt-24 order-2 md:order-1">
            <p class="text-sm font-medium tracking-wide text-muted-foreground uppercase mb-2">{projects[1].category}</p>
            <h3 class="text-3xl md:text-4xl font-medium text-foreground mb-4 group-hover:text-primary transition-colors">{projects[1].title}</h3>
            <p class="text-lg text-muted-foreground leading-relaxed">{projects[1].description}</p>
            <div class="mt-4">
              <a href={`/work/${projects[1].slug}`} class="text-sm font-medium text-primary hover:underline underline-offset-4">Explore Case Study</a>
            </div>
          </div>
          <a href={`/work/${projects[1].slug}`} class="block w-full md:w-[45%] aspect-[4/5] rounded-xl md:rounded-2xl overflow-hidden relative order-1 md:order-2 bg-surface">
            <img src={projects[1].image} alt={`${projects[1].title} preview`} class="w-full h-full object-cover object-center hover-scale-img" loading="lazy" />
          </a>
        </div>

        <!-- Project 3: Wide Moment -->
        <div class="group flex flex-col gap-6 md:gap-10 mt-16 md:mt-0">
          <a href={`/work/${projects[2].slug}`} class="block w-full aspect-[16/9] lg:aspect-[21/9] rounded-xl md:rounded-2xl overflow-hidden relative bg-surface">
            <img src={projects[2].image} alt={`${projects[2].title} preview`} class="w-full h-full object-cover object-center hover-scale-img" loading="lazy" />
          </a>
          <div class="max-w-3xl mx-auto text-center flex flex-col items-center">
            <p class="text-sm font-medium tracking-wide text-muted-foreground uppercase mb-3">{projects[2].category}</p>
            <h3 class="text-3xl md:text-4xl font-medium text-foreground mb-4 group-hover:text-primary transition-colors">{projects[2].title}</h3>
            <p class="text-lg text-muted-foreground leading-relaxed">{projects[2].description}</p>
            <div class="mt-4">
              <p class="text-sm font-medium text-foreground">{projects[2].year}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
