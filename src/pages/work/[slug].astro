---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';

export function getStaticPaths() {
  return [
    { 
      params: { slug: 'fintech-platform' }, 
      props: { 
        img: '/images/demo_webapp.png', 
        type: 'Web Application',
        description: 'Scalable transactional architecture handling robust data elements with sub-100ms response times.'
      } 
    },
    { 
      params: { slug: 'global-retail' }, 
      props: { 
        img: '/images/demo_ecommerce.png', 
        type: 'E-commerce',
        description: 'Headless commerce architecture engineered for lightning-fast cart interactions, robust product discovery, and global scale.'
      } 
    },
    { 
      params: { slug: 'architectural-firm' }, 
      props: { 
        img: '/images/demo_marketing.png', 
        type: 'Marketing Website',
        description: 'An editorial, highly optimized static site driven by a headless CMS, allowing the firm to effortlessly manage their case studies.'
      } 
    },
  ];
}

const { slug } = Astro.params;
const { img, type, description } = Astro.props;
---

<Layout 
  title={`${slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())} | Pradnya`}
  description={description}
>
  <SiteHeader slot="header" />

  <main class="flex flex-col min-h-screen pt-32 pb-32 px-4 md:px-8 bg-background">
    <div class="container mx-auto max-w-[1200px]">
      <div class="max-w-[1000px] mb-12">
        <p data-motion="hero-headline" class="text-sm font-medium tracking-wide text-foreground uppercase mb-4 block">{type}</p>
        <h1 data-motion="hero-headline" class="text-display-2 capitalize mb-6 text-foreground text-balance">
          {slug.replace(/-/g, ' ')}
        </h1>
        <p data-motion="hero-copy" class="text-xl text-muted-foreground leading-relaxed text-balance max-w-2xl">
          A deep dive into the architectural decisions and design engineering process behind this platform.
        </p>
      </div>

      <div data-motion="hero-media" class="w-full aspect-[4/3] md:aspect-[16/9] bg-surface mb-20 relative overflow-hidden" style="border-radius: var(--media-radius-featured)">
        <img src={img} alt={`${slug.replace(/-/g, ' ')} Hero Image`} class="w-full h-full object-cover object-top" loading="eager" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-16 mb-16">
        <div class="md:col-span-1 border-t border-border pt-8">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-4">Capabilities</h3>
          <ul class="flex flex-col gap-3 text-foreground text-sm">
            <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-border"></span>Frontend Architecture</li>
            <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-border"></span>Design System</li>
            <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 rounded-full bg-border"></span>Performance Audit</li>
          </ul>
        </div>
        <div class="md:col-span-2 border-t border-border pt-8 space-y-12">
          <div>
            <h2 class="text-2xl font-medium text-foreground mb-4">The Challenge</h2>
            <p class="text-muted-foreground text-lg leading-relaxed">
              The objective was to migrate a legacy system to a modern web architecture without compromising performance or accessibility. The interface required a high-density data display while maintaining a clean, editorial aesthetic.
            </p>
          </div>
          <div>
            <h2 class="text-2xl font-medium text-foreground mb-4">The Approach</h2>
            <p class="text-xl text-muted-foreground leading-relaxed">
              I implemented a headless architecture combined with static generation for maximum edge performance. The design system was engineered from the ground up, focusing on subtle motion, fluid typography, and precise material interactions.
            </p>
          </div>
        </div>
      </div>

      <!-- Secondary Media Sequence -->
      <div class="flex flex-col gap-16 md:gap-32 pb-16">
        <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-center">
          <div class="w-full md:w-1/2">
            <h3 class="text-2xl font-medium text-foreground mb-4">Interface Details</h3>
            <p class="text-muted-foreground text-lg leading-relaxed">
              Careful attention was paid to the micro-interactions and typographic scale, ensuring that density did not compromise clarity.
            </p>
          </div>
          <div class="w-full md:w-1/2 aspect-square md:aspect-[4/3] bg-surface overflow-hidden relative" style="border-radius: var(--media-radius-detail)">
             <img src={img} alt="Interface detail view" class="w-full h-full object-cover object-left-bottom" loading="lazy" />
          </div>
        </div>

        <div class="w-full aspect-video md:aspect-[21/9] bg-surface overflow-hidden relative" style="border-radius: var(--media-radius-featured)">
          <img src={img} alt="Wide landscape view of the project" class="w-full h-full object-cover object-center" loading="lazy" />
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
