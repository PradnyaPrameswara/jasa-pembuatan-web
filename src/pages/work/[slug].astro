---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { buttonVariants } from '../../components/ui/button';

const projectData = {
  'fintech-platform': {
    title: 'Fintech Platform',
    type: 'Web Application',
    description: 'A high-density transactional product shaped around fast decision-making, clear hierarchy, and dependable interaction patterns.',
    image: 'https://images.unsplash.com/photo-1748439435495-722cc1728b7e?auto=format&fit=crop&q=84&w=2400',
    imageAlt: 'Financial trading workspace with multiple analytics displays',
    capabilities: ['Product architecture', 'Data-dense interface', 'Performance tuning']
  },
  'global-retail': {
    title: 'Global Retail',
    type: 'E-Commerce',
    description: 'A commerce experience designed around product discovery, frictionless payment, and a system that remains coherent at scale.',
    image: 'https://images.unsplash.com/photo-1742836531244-de8454b8bc06?auto=format&fit=crop&q=84&w=2400',
    imageAlt: 'Minimal contactless payment terminal in a premium retail setting',
    capabilities: ['Commerce architecture', 'Checkout UX', 'Performance tuning']
  },
  'architectural-firm': {
    title: 'Architectural Firm',
    type: 'Editorial Website',
    description: 'A restrained editorial platform where photography, project narratives, and structural clarity lead the browsing experience.',
    image: 'https://images.unsplash.com/photo-1775735478842-c3bbcf5d2618?auto=format&fit=crop&q=84&w=2400',
    imageAlt: 'Minimal modern architecture facade with horizontal geometric lines',
    capabilities: ['Editorial direction', 'CMS architecture', 'Responsive systems']
  }
} as const;

export function getStaticPaths() {
  return Object.keys(projectData).map((slug) => ({
    params: { slug },
    props: projectData[slug as keyof typeof projectData]
  }));
}

const { title, type, description, image, imageAlt, capabilities } = Astro.props;
---

<Layout title={`${title} | Pradnya`} description={description}>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1200px]">
      <section class="grid gap-10 pb-14 md:grid-cols-[1fr_auto] md:items-end md:pb-20">
        <div class="max-w-4xl">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/85">{type}</p>
          <h1 class="text-balance text-[clamp(3.6rem,8vw,7rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">{title}</h1>
          <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">{description}</p>
        </div>
        <a href="/work" class={buttonVariants({ variant: 'ghost', size: 'lg', className: 'justify-self-start md:justify-self-end' })}>
          Back to work
        </a>
      </section>

      <figure class="media-shell overflow-hidden rounded-[30px] p-2 md:rounded-[38px] md:p-3">
        <div class="relative aspect-[4/3] overflow-hidden rounded-[24px] bg-white/10 md:aspect-[16/9] md:rounded-[31px]">
          <img src={image} alt={imageAlt} class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_58%,rgba(5,10,48,.32)_100%)]"></div>
        </div>
      </figure>

      <section class="grid gap-8 py-20 md:grid-cols-12 md:gap-12 md:py-28">
        <aside class="glass-panel rounded-[26px] p-6 md:col-span-4 md:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-white/46">Capabilities</p>
          <ul class="mt-7 space-y-4">
            {capabilities.map((capability: string) => (
              <li class="flex items-center gap-3 text-[15px] text-white/76">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan-spectrum"></span>
                {capability}
              </li>
            ))}
          </ul>
        </aside>

        <div class="space-y-12 md:col-span-8">
          <div class="border-t border-white/14 pt-7">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/75">01 · Challenge</p>
            <h2 class="text-[clamp(2rem,4vw,3.4rem)] font-semibold tracking-[-0.045em] text-white">Make complexity feel understandable.</h2>
            <p class="mt-5 max-w-3xl text-[17px] leading-[1.65] text-white/66">
              The work began by reducing competing priorities into a clear information hierarchy. Every visual decision had to support comprehension, speed, and confidence rather than add decorative noise.
            </p>
          </div>

          <div class="border-t border-white/14 pt-7">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/75">02 · Approach</p>
            <h2 class="text-[clamp(2rem,4vw,3.4rem)] font-semibold tracking-[-0.045em] text-white">Build the system before polishing the surface.</h2>
            <p class="mt-5 max-w-3xl text-[17px] leading-[1.65] text-white/66">
              Structure, responsive behavior, reusable primitives, and performance budgets were established first. The visual language was then refined around those constraints so the final interface remained durable and easy to extend.
            </p>
          </div>
        </div>
      </section>

      <section class="grid gap-8 pb-20 md:grid-cols-12 md:items-center md:gap-12">
        <div class="md:col-span-5">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/75">Interface detail</p>
          <h2 class="mt-4 text-[clamp(2.2rem,4vw,3.8rem)] font-semibold leading-[1] tracking-[-0.05em] text-white">Precision without visual weight.</h2>
          <p class="mt-5 text-[17px] leading-[1.62] text-white/65">Spacing, typography, image treatment, and interaction states were tuned to keep the experience calm even when the underlying product is complex.</p>
        </div>

        <div class="media-shell overflow-hidden rounded-[28px] p-2 md:col-span-7 md:rounded-[34px] md:p-3">
          <div class="aspect-[4/3] overflow-hidden rounded-[22px] md:rounded-[27px]">
            <img src={image} alt={`${imageAlt} — detail crop`} class="h-full w-full scale-105 object-cover object-center" loading="lazy" decoding="async" />
          </div>
        </div>
      </section>

      <section class="border-t border-white/14 py-16 text-center md:py-20">
        <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-white/46">Have a similar challenge?</p>
        <h2 class="mx-auto mt-4 max-w-3xl text-[clamp(2.6rem,5vw,5rem)] font-semibold leading-[0.96] tracking-[-0.055em] text-white">Turn the complexity into a clear digital system.</h2>
        <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'mt-8' })}>Discuss your project</a>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
