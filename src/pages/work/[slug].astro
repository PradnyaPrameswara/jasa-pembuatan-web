---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import { buttonVariants } from '../../components/ui/button';

import { work, type WorkEntry } from '../../data/work';

export function getStaticPaths() {
  return work.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: WorkEntry };
const {
  title, type, period, location, description,
  image, imageAlt, visualNote, focus, highlights, overview,
} = project;

---

<Layout title={`${title} | Pradnya Prameswara`} description={description}>
  <SiteHeader slot="header" />

  <main class="min-h-screen bg-transparent px-5 pb-32 pt-32 text-foreground sm:px-8 md:pt-40">
    <div class="mx-auto max-w-[1200px]">
      <section class="grid gap-10 pb-14 md:grid-cols-[1fr_auto] md:items-end md:pb-20">
        <div class="max-w-4xl">
          <p class="mb-5 text-[12px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/85">{type}</p>
          <h1 class="text-balance text-[clamp(2.85rem,8vw,7rem)] font-semibold leading-[0.92] tracking-[-0.06em] text-white">{title}</h1>
          <p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.8vw,1.35rem)] leading-[1.55] text-white/68">{description}</p>
        </div>
        <a href="/work" class={buttonVariants({ variant: 'ghost', size: 'lg', className: 'justify-self-start md:justify-self-end' })}>
          Back to experience
        </a>
      </section>

      <figure class="media-shell overflow-hidden rounded-[30px] p-2 md:rounded-[38px] md:p-3">
        <div class="relative aspect-[4/3] overflow-hidden rounded-[24px] bg-white/10 md:aspect-[16/9] md:rounded-[31px]">
          <img src={image} alt={imageAlt} width="1200" height="750" class="h-full w-full object-cover object-center" loading="eager" decoding="async" />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,48,0)_58%,rgba(5,10,48,.32)_100%)]"></div>
        </div>
      </figure>
      <p class="mt-3 text-[12px] leading-relaxed text-white/55">{visualNote}</p>

      <section class="grid gap-8 py-20 md:grid-cols-12 md:gap-12 md:py-28">
        <aside class="glass-panel rounded-[26px] p-6 md:col-span-4 md:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-white/46">Profile facts</p>
          <dl class="mt-7 space-y-5">
            <div><dt class="text-[11px] uppercase tracking-[0.12em] text-white/40">Period</dt><dd class="mt-1 text-[15px] text-white/76">{period}</dd></div>
            <div><dt class="text-[11px] uppercase tracking-[0.12em] text-white/40">Location</dt><dd class="mt-1 text-[15px] text-white/76">{location}</dd></div>
          </dl>
          <p class="mt-8 text-[11px] font-semibold uppercase tracking-[0.15em] text-white/46">Focus areas</p>
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Focus areas">
            {focus.map((area: string) => <li class="rounded-full border border-white/20 px-3 py-1.5 text-[12px] text-white/75">{area}</li>)}
          </ul>
          <p class="mt-8 text-[11px] font-semibold uppercase tracking-[0.15em] text-white/46">Verified highlights</p>
          <ul class="mt-4 space-y-3">
            {highlights.map((highlight: string) => (
              <li class="flex items-center gap-3 text-[15px] text-white/76">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan-spectrum"></span>
                {highlight}
              </li>
            ))}
          </ul>
        </aside>

        <div class="md:col-span-8">
          <div class="border-t border-white/14 pt-7">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-cyan-spectrum/75">Overview</p>
            <h2 class="text-[clamp(2rem,4vw,3.4rem)] font-semibold tracking-[-0.045em] text-white">Context and contribution.</h2>
            <p class="mt-5 max-w-3xl text-[17px] leading-[1.65] text-white/66">{overview}</p>
          </div>
        </div>
      </section>

      <section class="border-t border-white/14 py-16 text-center md:py-20">
        <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-white/46">Interested in working together?</p>
        <h2 class="mx-auto mt-4 max-w-3xl text-[clamp(2.6rem,5vw,5rem)] font-semibold leading-[0.96] tracking-[-0.055em] text-white">I am open to full-time software development opportunities.</h2>
        <a href="/contact" class={buttonVariants({ variant: 'default', size: 'lg', className: 'mt-8' })}>Get in touch</a>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
