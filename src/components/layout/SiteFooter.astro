---
import { buttonVariants } from '../ui/button';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer dark-env mt-auto relative z-10 px-3 pb-3 sm:px-5 sm:pb-5 lg:px-6 lg:pb-6">
  <div class="site-footer-shell mx-auto max-w-[1440px] overflow-hidden rounded-[30px] px-6 pb-8 pt-16 sm:rounded-[34px] md:px-10 md:pb-10 md:pt-20 lg:px-12">
    <div class="grid grid-cols-1 gap-14 md:grid-cols-2 lg:grid-cols-[1.25fr_0.75fr_1fr] lg:gap-10">
      <div class="flex flex-col items-start">
        <a
          href="/"
          class="mb-5 inline-block rounded-md text-[clamp(2rem,4vw,3.6rem)] font-semibold leading-none tracking-[-0.05em] text-white transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-offset-4 focus-visible:ring-offset-transparent"
        >
          Pradnya<span class="text-[#00ffff]">.</span>
        </a>
        <p class="max-w-md text-[17px] leading-[1.6] text-white/66">
          Design engineering for fast, clear, and durable digital experiences.
        </p>
      </div>

      <nav class="flex flex-col" aria-label="Footer Navigation">
        <span class="mb-5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/46">Navigation</span>
        <div class="flex flex-col gap-1">
          <a href="/work" class="site-footer-link">Work</a>
          <a href="/services" class="site-footer-link">Services</a>
          <a href="/about" class="site-footer-link">About</a>
          <a href="/contact" class="site-footer-link">Contact</a>
        </div>
      </nav>

      <div class="flex flex-col items-start lg:items-end">
        <span class="mb-5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/46">Start a conversation</span>
        <p class="mb-7 max-w-sm text-[15px] leading-[1.6] text-white/64 lg:text-right">
          Have a product, redesign, or web platform that needs a more precise execution?
        </p>
        <a
          href="/contact"
          class={buttonVariants({ variant: 'default', size: 'lg', className: 'site-footer-cta' })}
        >
          Discuss Your Project
        </a>

        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 lg:justify-end">
          <a
            href="https://www.linkedin.com/in/pradnyaprameswara/"
            target="_blank"
            rel="noopener noreferrer"
            class="site-footer-meta-link"
            aria-label="LinkedIn Profile"
          >
            LinkedIn
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
          <a href="mailto:hello@example.com" class="site-footer-meta-link">hello@example.com</a>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/15 pt-6 text-[12px] text-white/44 md:mt-18 md:flex-row md:items-center md:justify-between">
      <p>&copy; {currentYear} Pradnya Prameswara. All rights reserved.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="#" class="transition-colors hover:text-white/80">Privacy Policy</a>
        <a href="#" class="transition-colors hover:text-white/80">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
