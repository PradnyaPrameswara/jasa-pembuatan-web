---
// src/components/layout/SiteFooter.astro
const currentYear = new Date().getFullYear();
---

<footer class="dark-env bg-background border-t border-border text-foreground mt-auto relative z-10">
  <div class="container mx-auto max-w-[1440px] px-6 md:px-12 pt-24 pb-12">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-16 lg:gap-8 mb-24">

      <!-- Brand & Positioning (Left/Top) -->
      <div class="flex flex-col items-start lg:col-span-1">
        <a href="/" class="text-display-3 font-medium tracking-tight text-foreground inline-block mb-4 hover:opacity-80 transition-opacity focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm">
          Pradnya<span class="text-primary">.</span>
        </a>
        <p class="text-lg text-muted-foreground max-w-sm leading-relaxed">
          Engineering scalable digital platforms. Technical precision meets premium design.
        </p>
      </div>

      <!-- Primary Navigation (Center) -->
      <div class="flex lg:justify-center">
        <nav class="flex flex-col space-y-4" aria-label="Footer Navigation">
          <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">Navigation</span>
          <a href="/work" class="text-foreground hover:text-primary transition-colors font-medium w-fit focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm">Work</a>
          <a href="/services" class="text-foreground hover:text-primary transition-colors font-medium w-fit focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm">Services</a>
          <a href="/about" class="text-foreground hover:text-primary transition-colors font-medium w-fit focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm">About</a>
          <a href="/contact" class="text-foreground hover:text-primary transition-colors font-medium w-fit focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm">Contact</a>
        </nav>
      </div>

      <!-- Contact & CTA (Right/Bottom) -->
      <div class="flex flex-col items-start lg:items-end md:col-span-2 lg:col-span-1 mt-8 md:mt-0">
        <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-6">Start a conversation</span>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-8 lg:flex-row-reverse">
          <a
            href="https://www.linkedin.com/in/pradnyaprameswara/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-sm font-medium text-muted-foreground hover:text-primary transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm"
            aria-label="LinkedIn Profile"
          >
            LinkedIn
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 opacity-70"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
          <a href="mailto:hello@example.com" class="text-foreground hover:text-primary transition-colors text-sm font-medium focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 rounded-sm">
            hello@example.com
          </a>
        </div>

        <a href="/contact" class="btn-interactive btn-material-primary px-6 py-3 rounded-full font-medium inline-flex items-center focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-4">
          Discuss Your Project
        </a>
      </div>

    </div>

    <!-- Legal Row (Bottom) -->
    <div class="pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-muted-foreground">
      <p>&copy; {currentYear} Pradnya Prameswara. All rights reserved.</p>
      <div class="flex gap-8">
        <a href="#" class="hover:text-foreground transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-foreground transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
