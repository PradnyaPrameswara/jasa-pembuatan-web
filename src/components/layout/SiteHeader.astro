---
import { MobileNav } from '../interactive/MobileNav.tsx';

const links = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<div id="header-sentinel" class="absolute top-0 w-full h-[1px] pointer-events-none opacity-0" aria-hidden="true"></div>
<header id="site-header" class="sticky top-0 z-50 w-full site-header">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-6 md:px-8">
    <a href="/" class="text-lg font-bold tracking-tight hover:opacity-80 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm">
      <span class="text-primary">P</span><span class="text-foreground">radnya.</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-7">
      {links.map((link) => (
        <a href={link.href} class="text-[13px] font-medium text-foreground/75 hover:text-foreground transition-colors tracking-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-sm">
          {link.label}
        </a>
      ))}
      <a href="/contact" class="inline-flex h-8 items-center justify-center rounded-md bg-primary px-4 py-1 text-[13px] font-medium text-primary-foreground interactive-scale hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background ml-2">
        Discuss Your Project
      </a>
    </nav>

    <!-- Mobile Nav Toggle (React Island) -->
    <MobileNav client:media="(max-width: 767px)" />
  </div>
</header>

<script>
  const sentinel = document.getElementById('header-sentinel');
  const header = document.getElementById('site-header');

  if (sentinel && header) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        // When sentinel is fully out of view, we've scrolled down
        if (!entry.isIntersecting) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      },
      { rootMargin: '0px', threshold: 0 }
    );
    observer.observe(sentinel);
  }
</script>
